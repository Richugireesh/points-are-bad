# Points Are Bad — Docker Compose environment
#
# Copy this file to .env and adjust values:
#   cp .env.example .env
#
# Generate a strong API token:
#   openssl rand -hex 32

# Required: shared secret for write endpoints (POST /predictions, /results, /players)
API_TOKEN=

# Optional: TCP port for the web dashboard (default: 5001)
PORT=5001

# Optional: set to "false" to disable rate limiting during local development
RATELIMIT_ENABLED=true

# Optional: number of Gunicorn workers (default: 2)
# GUNICORN_WORKERS=2

# ── Tailscale ──────────────────────────────────────────────────────────────
# Required to use the Tailscale sidecar.  Generate a key at:
#   https://login.tailscale.com/admin/settings/keys
# TS_AUTHKEY=tskey-auth-...

# Optional: hostname on your tailnet (default: points-are-bad)
# TS_HOSTNAME=points-are-bad
